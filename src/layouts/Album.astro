---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import type { PersonBirthdayData } from "@/types";

import Metadata from "@/components/Metadata.astro";
import Container from "@/components/Container.astro";
import BackgroundHearts from "@/components/BackgroundHearts.astro";
import MainPhoto from "@/components/MainPhoto.astro";
import MusicPlayerFrame from "@/components/MusicPlayerFrame.astro";
import LifeCount from "@/components/LifeCount.astro";
import Cita from "@/components/Cita.astro";
import PhotoVentoGrid from "@/components/PhotoVentoGrid.astro";
import FeedbackLabel from "@/components/FeedbackLabel.astro";
import Author from "@/components/Author.astro";
import Confetti from "@/components/Confetti.astro";

export interface AlbumProps {
    personData: PersonBirthdayData;
}

const { personData } = Astro.props as AlbumProps;
const quoteMessage = personData.quote?.trim() ?? "";
const hasQuote = quoteMessage.length > 0;

const styles: Record<string, [string, string]> = {
    body: [
        "album-page min-h-screen relative overflow-x-hidden",
        `
            color: ${personData.theme.secondaryColor};
            background: ${personData.theme.backgroundColor};
            --theme-primary-color: ${personData.theme.primaryColor};
            --theme-secondary-color: ${personData.theme.secondaryColor};
            --cita-text-color: ${personData.theme.complementaryColor?.[2] ?? personData.theme.primaryColor};
            --cita-wrap-color: ${personData.theme.complementaryColor?.[3] ?? personData.theme.secondaryColor + "c5"};
            --cita-qmark-color: ${personData.theme.complementaryColor?.[4] ?? personData.theme.primaryColor + "c5"};
            --cita-border-color: ${personData.theme.complementaryColor?.[5] ?? personData.theme.secondaryColor + '24'};
            --cita-shadow1-color: ${personData.theme.complementaryColor?.[6] ?? personData.theme.secondaryColor + '47'};
            --cita-shadow2-color: ${personData.theme.complementaryColor?.[7] ?? personData.theme.secondaryColor + '1f'};
            --music-pulse-compl1-color: ${personData.theme.complementaryColor?.[0] ?? personData.theme.primaryColor + "40"};
            --music-pulse-compl2-color: ${personData.theme.complementaryColor?.[1] ?? personData.theme.primaryColor + "1f"};
        `,
    ],
};
---

<html lang="es">
    <head>
        <Metadata
            title={personData.title}
            name={`${personData.firstName} ${personData.lastName}`}
            message={personData.message}
            theme={{
                backgroundColor: personData.theme.backgroundColor,
                primaryColor: personData.theme.primaryColor,
                secondaryColor: personData.theme.secondaryColor,
            }}
        />

        <ClientRouter />
    </head>

    <body class={styles.body[0]} style={styles.body[1]}>
        <BackgroundHearts heartsColor={personData.bgDecoration?.heartsColor ?? { cel: personData.theme.secondaryColor, pc: personData.theme.primaryColor }} />

        <Container contentSpace="full">
            <div class="album">
                <section class="hero">
                    <div class="hero-media">
                        <MainPhoto personData={personData} className="album-photo">
                            <MusicPlayerFrame
                                personData={personData}
                                songs={personData.songList ?? undefined}
                                targetClass="album-photo"
                            />
                        </MainPhoto>

                        <h1
                            class="name-3d"
                            transition:name="name"
                            transition:animate="slide"
                        >
                            <span>{personData.firstName}</span>
                            <span>{personData.lastName}</span>
                        </h1>
                    </div>
                </section>

                <div class="album-content">
                    <section class="counter-zone timeline-view animate-fade-in-up animate-range-[entry_10%_contain_35%]">
                        <h2
                            class="subtitle"
                            style={`color: var(--theme-primary-color);`}
                            transition:name="subtitle"
                            transition:animate="fade"
                        >
                            ¡Felicidades, has sobrevivido!
                        </h2>

                        <LifeCount personData={personData} size="large" />
                    </section>

                    {
                        
                        hasQuote && (
                            <br />
                            <h2
                                class="subtitle"
                                style={`color: var(--theme-primary-color);`}
                                id="subtitle-quote"
                                transition:name="subtitle-quote"
                                transition:animate="fade"
                            >
                                Frases que la Lady Gaga <i>sí</i> dijó...
                            </h2>
                            <section class="quote-zone timeline-view animate-fade-in-up animate-delay-100 animate-range-[entry_15%_contain_40%]">
                                <Cita
                                    mensaje={quoteMessage}
                                    author={`${personData.firstName} ${personData.lastName}`}
                                />
                            </section>
                        )
                    }

                    <br />

                    <PhotoVentoGrid personData={personData} titleColor={personData.theme.primaryColor} />
                
                    <br />

                    <h1 class="thanks timeline-view animate-fade-in-up animate-range-[entry_15%_contain_40%]">
                        Joder que buena tía, me cago en la madre que te parió Lady.
                    </h1>
                    <h2
                        class="subtitle timeline-view animate-fade-in-up animate-range-[entry_15%_contain_40%]"
                        style={`color: var(--theme-secondary-color)24;`}
                        id="text-thanks"
                        transition:name="subtitle"
                        transition:animate="fade"
                    >
                        Happy Birthday, Lady... Te quiero un chingo, y espero que este día sea tan increíble como tú... LA PRO xD.
                    </h2>
                </div>
            </div>
        </Container>
        
        <Author />
        <FeedbackLabel label="Hubiera quedado chido el BENTO GRID en PC y con más fotos :c" />
        <Confetti confettiColors={personData.theme.complementaryColor} />
    </body>
</html>

<style is:global>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: Inter, system-ui, sans-serif;
    }

    @view-transition {
        navigation: auto;
    }

    .album {
        width: 100%;
        margin: 0 auto;
        padding: 0 0 4rem;
        display: grid;
        gap: 1.6rem;
        z-index: 2;
    }

    .hero {
        position: relative;
        width: 100vw;
        min-height: 108svh;
        margin-left: calc(50% - 50vw);
        overflow: hidden;
    }

    .hero-media {
        width: 100%;
        height: 100%;
        position: relative;
    }

    .hero .photo-container {
        width: 100%;
        height: 100%;
        display: inline-block;
        position: relative;
    }

    .hero::after {
        content: "";
        position: absolute;

        left: 0;
        right: 0;
        bottom: 0;

        height: 40%;

        pointer-events: none;
        z-index: 2;

        background: linear-gradient(
            to bottom,
            #05050500,
            #05050533,
            #050505cd,
            #050505
        );
    }

    .name-3d {
        position: absolute;
        z-index: 3;
        left: 50%;
        top: clamp(3.4rem, 12vh, 7.4rem);
        transform: translateX(-50%);
        text-align: center;
        width: min(95vw, 1100px);
        font-size: clamp(2.3rem, 6vw, 5rem);
        line-height: 1.02;
        font-weight: 850;
        color: var(--theme-secondary-color);
        letter-spacing: 0.9px;
        text-shadow:
            0 1px 0 rgba(255, 255, 255, 0.25),
            0 3px 0 color-mix(in srgb, var(--theme-primary-color) 52%, black),
            0 14px 30px rgba(0, 0, 0, 0.6);
    }

    .name-3d span {
        display: block;
    }

    .album-content {
        width: min(100%, 1180px);
        margin: 0 auto;
        padding: 4rem 1rem;
        display: grid;
        gap: 2rem;
    }

    .quote-zone {
        width: min(100%, 1020px);
        margin: -0.25rem auto 0.25rem;
    }

    .counter-zone {
        text-align: center;
    }

    .subtitle {
        text-align: center;
        font-size: clamp(1.1rem, 2.4vw, 1.5rem);
        font-weight: 700;
        letter-spacing: 0.8px;
        margin-bottom: 1.2rem;
    }
    #subtitle-quote {
        margin-bottom: 0rem;
    }

    .album-photo {
        position: relative;
        width: 100%;
        height: 108svh;
        overflow: hidden;
        border-radius: 0;
        box-shadow: none;
        background: #050505;
    }

    .album-photo > a,
    .album-photo > img {
        position: absolute;
        inset: 0;
        z-index: 1;
        display: block;
        border-radius: 0;
        overflow: hidden;
        background: #050505;
    }

    .album-photo > a > img,
    .album-photo > img {
        width: 100%;
        height: 100%;
        border-radius: 0;
        object-fit: cover;
    }

    .music-btn {
        position: absolute;
        left: 50%;
        right: 15%;
        top: 73%;
        transform: translate(-50%, -50%);
        border: 2px solid var(--music-btn-primary);
        color: var(--music-btn-primary);
        padding: .75rem 1.25rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .25rem;
        background: rgba(5,5,5,.6);
        backdrop-filter: blur(8px);
        border-radius: 999px;
        cursor: pointer;
        transition: all .3s ease;
        z-index: 10;
    }

    .thanks {
        text-align: center;
        font-size: clamp(1.3rem, 2.8vw, 1.8rem);
        font-weight: 700;
        letter-spacing: 0.8px;
        margin-top: 2rem;
        color: var(--theme-primary-color);
    }
    
    .text-thanks {
        margin: 0 auto;
        text-align: center;
    }

    @media (max-width: 900px) {
        .album {
            gap: 1.5rem;
            padding-bottom: 2rem;
        }

        .hero {
            min-height: 100svh;
        }

        .name-3d {
            top: clamp(3rem, 50vh, 6.5rem);
            font-size: clamp(2.35rem, 9.4vw, 3.2rem);
            text-shadow:
                0 1px 0 rgba(255, 255, 255, 0.2),
                0 2px 0 color-mix(in srgb, var(--theme-primary-color) 55%, black),
                0 8px 20px rgba(0, 0, 0, 0.56);
        }

        .music-btn {
            left: 50%;
            right: -15%;
            top: 75%;
        }

        .album-content {
            padding: 0 0.8rem;
            gap: 1.5rem;
        }

        .album-photo {
            height: 100svh;
        }

        .text-thanks {
            font-size: clamp(1.1rem, 2.4vw, 1.4rem);
            text-shadow: 0 1px 0 rgba(255, 255, 255, 0.25), 0 3px 0 color-mix(in srgb, var(--theme-primary-color) 52%, black), 0 14px 30px rgba(0, 0, 0, 0.6);
            text-align: justify;
            margin: auto 1.1rem;
        }
    }
</style>
