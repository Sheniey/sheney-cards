---
import * as media from '@/config/media';
import type { PersonBirthdayData, Song } from '@/types';

export interface MusicPlayerFrameProps {
    personData: PersonBirthdayData;
    songs?: Song[];
    targetClass: string;
}

const defaultSong: Song = {
    title: 'Las Mañanitas',
    filename: media.getMusicURL('mañanitas.mp3'),
    alt: 'Las Mañanitas cantadas por Vicente Fernández',
    type: 'audio/mpeg',
};

const { personData, songs = [defaultSong], targetClass } = Astro.props as MusicPlayerFrameProps;
const safeSongs = songs.length > 0
    ? songs.map((song) => ({
        ...song,
        filename: media.getMusicURL(song.filename),
    }))
    : [defaultSong]
;
const initialSong = safeSongs[0];
const playerId = crypto.randomUUID();
const buttonId = `music-toggle-${playerId}`;
const iconId = `music-icon-${playerId}`;
const textId = `music-text-${playerId}`;
const audioId = `song-${playerId}`;
const storageKey = `birthday-current-song-${personData.nameId}`;

const Icons = {
    play: '<svg style="fill: currentColor; color: inherit;" xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor"><path d="M336-216v-528l408 264-408 264Zm73-265Zm-1 133 204-132-204-132v264Z"/></svg>',
    pause: '<svg style="fill: currentColor; color: inherit;" xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor"><path d="M528-192v-576h240v576H528Zm-336 0v-576h240v576H192Zm408-72h96v-432h-96v432Zm-336 0h96v-432h-96v432Zm0-432v432-432Zm336 0v432-432Z"/></svg>',
};

const CSSVariables = `
    --music-btn-primary: ${personData.theme.primaryColor};
    --music-btn-secondary: ${personData.theme.secondaryColor};
    --music-btn-compl1: ${personData.theme.primaryColor}40;
    --music-btn-compl2: ${personData.theme.primaryColor}a6;
`;

const getPlayLabel = (songName: string) => `Reproducir ${songName}`;
const getPauseLabel = (songName: string) => `Pausar ${songName}`;
---

<button
    id={buttonId}
    type="button"
    class="music-btn"
    style={CSSVariables}
    transition:name="music-btn"
    transition:animate="fade"
>
    <span id={iconId}>{Icons.pause}</span>
    <span id={textId}>{getPauseLabel(initialSong.title)}</span>
</button>

<audio id={audioId}>
    <source src={initialSong.filename} type={initialSong.type} />
</audio>

<script>
    const audio = document.getElementById('audio');

    if (audio) {
        audio?.addEventListener('loadedmetadata', () => {
            audio.currentTime = 23;
        });
    }
</script>

<script
    define:vars={{
        Icons,
        safeSongs,
        targetClass,
        buttonId,
        iconId,
        textId,
        audioId,
        storageKey,
    }}
    is:inline
>
    const button = document.getElementById(buttonId);
    const audio = document.getElementById(audioId);
    const icon = document.getElementById(iconId);
    const text = document.getElementById(textId);
    const frame = document.querySelector(`.${targetClass}`);

    if (button && audio instanceof HTMLAudioElement && icon && text) {
        const source = audio.querySelector('source');
        const getPlayLabel = (songName) => `Reproducir ${songName}`;
        const getPauseLabel = (songName) => `Pausar ${songName}`;

        if (!source) {
            throw new Error('Audio source element not found');
        }

        const storedFilename = localStorage.getItem(storageKey);
        let currentIndex = Math.max(
            safeSongs.findIndex((song) => song.filename === storedFilename),
            0,
        );

        function applySong(index, keepState = false) {
            currentIndex = index % safeSongs.length;
            const currentSong = safeSongs[currentIndex];
            source.src = currentSong.filename;
            source.type = currentSong.type;
            audio.load();
            localStorage.setItem(storageKey, currentSong.filename);

            if (!keepState || !audio.paused) {
                audio.play().then(() => {
                    icon.innerHTML = Icons.pause;
                    text.textContent = getPauseLabel(currentSong.title);
                }).catch(() => {
                    icon.innerHTML = Icons.play;
                    text.textContent = getPlayLabel(currentSong.title);
                });
            } else {
                icon.innerHTML = Icons.play;
                text.textContent = getPlayLabel(currentSong.title);
            }
        }

        applySong(currentIndex, true);

        audio.addEventListener('play', () => {
            frame?.classList.add('playing');
            text.textContent = getPauseLabel(safeSongs[currentIndex].title);
            icon.innerHTML = Icons.pause;
        });

        audio.addEventListener('pause', () => {
            frame?.classList.remove('playing');
            text.textContent = getPlayLabel(safeSongs[currentIndex].title);
            icon.innerHTML = Icons.play;
        });

        audio.addEventListener('ended', () => {
            frame?.classList.remove('playing');
            applySong((currentIndex + 1) % safeSongs.length);
        });

        button.addEventListener('click', () => {
            if (audio.paused) {
                audio.play().then(() => {
                    icon.innerHTML = Icons.pause;
                    text.textContent = getPauseLabel(safeSongs[currentIndex].title);
                }).catch(() => {
                    icon.innerHTML = Icons.play;
                    text.textContent = getPlayLabel(safeSongs[currentIndex].title);
                });
                return;
            }

            audio.pause();
            icon.innerHTML = Icons.play;
            text.textContent = getPlayLabel(safeSongs[currentIndex].title);
        });
    }
</script>

<style>
    .music-btn {
        border: 2px solid var(--music-btn-primary);
        color: var(--music-btn-primary);
        margin-top: 1rem;
        padding: .75rem 1.25rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .25rem;
        background: transparent;
        border-radius: 999px;
        cursor: pointer;
        transition: all .3s ease;
    }

    .music-btn:hover {
        background-color: var(--music-btn-primary);
        color: var(--music-btn-secondary);
    }

    @media (max-width: 900px) {
        .music-btn {
            padding: .5rem 1rem !important;
        }
    }
</style>

<style is:global>
    .playing {
        animation: pulse 2s infinite !important;
    }

    @keyframes pulse {
        0% {
            box-shadow: 0 0 25px var(--mphoto-compl1-color);
        }
        70% {
            box-shadow: 0 0 55px var(--mphoto-compl3-color);
        }
        100% {
            box-shadow: 0 0 25px var(--mphoto-compl1-color);
        }
    }
</style>
